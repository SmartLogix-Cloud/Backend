          <mxGeometry x="719" y="460" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="msuser" value="&lt;b&gt;ms-user&lt;/b&gt;&lt;br&gt;Usuarios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="841" y="460" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="msanalytics" value="&lt;b&gt;ms-analytics&lt;/b&gt;&lt;br&gt;Consume ambos tópicos&lt;br&gt;Métricas en memoria&lt;br&gt;REST + SSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="963" y="460" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="dbinv" value="db-inventory" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="485" y="600" width="90" height="65" as="geometry" />
        </mxCell>
        <mxCell id="dborder" value="db-order" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
