        <!-- ===================== Backend EC2 ===================== -->
        <mxCell id="bff" value="&lt;b&gt;BFF Node.js 20 (:3000)&lt;/b&gt;&lt;br&gt;Revalida JWT de Entra&lt;br&gt;RBAC: perfil → permisos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="brokeradmin" value="&lt;b&gt;ms-broker-admin&lt;/b&gt;&lt;br&gt;Admin RabbitMQ + Kafka&lt;br&gt;(/api/admin solo Admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1">
