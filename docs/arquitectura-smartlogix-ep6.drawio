        <mxCell id="msorder" value="&lt;b&gt;ms-order&lt;/b&gt;&lt;br&gt;Produce order-events&lt;br&gt;Consume shipment-events&lt;br&gt;(proyección seguimiento)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1">
