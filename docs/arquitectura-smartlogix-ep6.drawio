        </mxCell>
        <mxCell id="dbship" value="db-shipping" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="729" y="600" width="90" height="65" as="geometry" />
        </mxCell>
        <mxCell id="dbuser" value="db-user" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="851" y="600" width="90" height="65" as="geometry" />
        </mxCell>
        <mxCell id="benote" value="PostgreSQL 16 por servicio (Flyway), sin FKs cruzadas.&lt;br&gt;ms-analytics no tiene BD: al arrancar hace &lt;i&gt;replay&lt;/i&gt; de los tópicos." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="475" y="700" width="610" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== RabbitMQ ===================== -->
        <mxCell id="rabbit1" value="&lt;b&gt;RabbitMQ rabbit1&lt;/b&gt;&lt;br&gt;AMQP :5672 · UI :15672" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="330" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="rabbit2" value="&lt;b&gt;RabbitMQ rabbit2&lt;/b&gt;&lt;br&gt;AMQP :5672 · UI :15672" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1010" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="rabbitnote" value="Clúster de 2 nodos en 2 EC2 (Erlang cookie compartida).&lt;br&gt;Colas classic: viven en el nodo que las declara." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#8A5A00;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1010" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="topology" value="&lt;b&gt;Topología RabbitMQ (EP2, sin cambios)&lt;/b&gt;&lt;br&gt;Exchanges: &lt;b&gt;smartlogix.commands&lt;/b&gt; (direct) · &lt;b&gt;smartlogix.events&lt;/b&gt; (topic) · &lt;b&gt;smartlogix.dlx&lt;/b&gt; (direct)&lt;br&gt;Colas (cada una con .dlq y listener · TTL 5 min · máx. 10.000 mensajes):&lt;br&gt;• shipping.order-ready.q ← commands / order.ready-for-shipment → ms-shipping crea el envío&lt;br&gt;• shipping.order-cancelled.q ← commands / order.cancelled&lt;br&gt;• order.shipment-delivered.q ← events / shipment.delivered → pedido FINALIZADO&lt;br&gt;• order.shipment-lost.q ← events / shipment.lost → pedido INCIDENCIA&lt;br&gt;• order.customer-notify.q ← events / shipment.# (notificación)&lt;br&gt;• shipping.audit.q ← events / # (auditoría)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="830" width="640" height="190" as="geometry" />
        </mxCell>

        <!-- ===================== Kafka ===================== -->
        <mxCell id="zklabel" value="Ensemble Zookeeper · quorum 2 de 3 · metadatos y elección del controller" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="1180" y="460" width="520" height="20" as="geometry" />
        </mxCell>
        <mxCell id="zk1" value="zookeeper1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1185" y="485" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="zk2" value="zookeeper2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1365" y="485" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="zk3" value="zookeeper3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1545" y="485" width="150" height="45" as="geometry" />
        </mxCell>

        <mxCell id="k1" value="&lt;b&gt;kafka1&lt;/b&gt; :9092&lt;br&gt;rack-1 · controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1185" y="590" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="k2" value="&lt;b&gt;kafka2&lt;/b&gt; :9093&lt;br&gt;rack-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1365" y="590" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="k3" value="&lt;b&gt;kafka3&lt;/b&gt; :9094&lt;br&gt;rack-3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1545" y="590" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="durability" value="RF 3 · min.insync.replicas 2 · acks=all · idempotencia · unclean.leader.election=false · auto.create.topics=false" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6B4C80;" vertex="1" parent="1">
          <mxGeometry x="1180" y="652" width="520" height="20" as="geometry" />
        </mxCell>

        <mxCell id="topics" value="&lt;b&gt;Tópicos&lt;/b&gt; (3 particiones · 3 réplicas)&lt;br&gt;• &lt;b&gt;smartlogix.order-events&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;key = orderId · delete · 7 días&lt;br&gt;• &lt;b&gt;smartlogix.shipment-events&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;key = shipmentId · compact,delete · 30 días&lt;br&gt;• *.DLT · delete · 14 días&lt;br&gt;&lt;br&gt;&lt;b&gt;Consumer groups&lt;/b&gt; (concurrency 3)&lt;br&gt;• ms-analytics-orders → order-events&lt;br&gt;• ms-analytics-shipments → shipment-events&lt;br&gt;• ms-order-shipment-tracking → shipment-events" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="685" width="320" height="210" as="geometry" />
        </mxCell>
        <mxCell id="kafkaui" value="&lt;b&gt;Kafka UI&lt;/b&gt; :8088&lt;br&gt;provectuslabs v0.7.2&lt;br&gt;Brokers · tópicos · mensajes&lt;br&gt;consumer groups · lag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1530" y="700" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kafkainit" value="kafka-init&lt;br&gt;(crea tópicos, idempotente)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1530" y="810" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== Leyenda ===================== -->
        <mxCell id="legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1F5FBF&quot;&gt;━━&lt;/font&gt; HTTPS / REST&lt;br&gt;&lt;font color=&quot;#0078D4&quot;&gt;╍╍&lt;/font&gt; Autenticación (OIDC / JWT / JWKS)&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;━━&lt;/font&gt; AMQP (RabbitMQ: comandos y eventos)&lt;br&gt;&lt;font color=&quot;#9673A6&quot;&gt;━━&lt;/font&gt; Kafka (producción / consumo)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;━━&lt;/font&gt; JDBC (PostgreSQL)&lt;br&gt;&lt;br&gt;&lt;b&gt;Puertos expuestos&lt;/b&gt;&lt;br&gt;• BFF :3000 → solo API Gateway (recomendado)&lt;br&gt;• Kafka 9092-9094 y AMQP 5672 → solo desde smartlogix-sg&lt;br&gt;• Kafka UI 8088 y RabbitMQ UI 15672 → navegador (con login)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="640" width="380" height="220" as="geometry" />
        </mxCell>

