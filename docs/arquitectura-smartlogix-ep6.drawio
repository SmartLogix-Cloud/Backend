        <!-- ===================== API Gateway ===================== -->
        <mxCell id="apigw" value="&lt;b&gt;AWS API Gateway (HTTP API)&lt;/b&gt;&lt;br&gt;Autorizador JWT: issuer + audience de Entra&lt;br&gt;Rechaza sin token / token inválido (401) · CORS" style="outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=middle;labelPosition=right;align=left;spacingLeft=8;verticalAlign=middle;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="640" y="130" width="60" height="60" as="geometry" />
