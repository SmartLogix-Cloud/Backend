        <mxCell id="title" value="&lt;b&gt;SmartLogix — Arquitectura EP6&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Frontend e IDaaS en Azure · API Gateway, backend, RabbitMQ (2 nodos en 2 EC2) y Kafka (3 Zookeeper + 3 brokers) en AWS&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#0B1C30;" vertex="1" parent="1">
