# SmartLogix - variables de entorno
# Copiar a .env: cp .env.example .env

# === Postgres - DB-per-service ===
POSTGRES_INVENTARIO_DB=inventario
POSTGRES_INVENTARIO_USER=inventario
POSTGRES_INVENTARIO_PASSWORD=inventario_dev_pass

POSTGRES_PEDIDO_DB=pedido
POSTGRES_PEDIDO_USER=pedido
POSTGRES_PEDIDO_PASSWORD=pedido_dev_pass

POSTGRES_ENVIO_DB=envio
POSTGRES_ENVIO_USER=envio
POSTGRES_ENVIO_PASSWORD=envio_dev_pass

POSTGRES_USUARIO_DB=usuario
POSTGRES_USUARIO_USER=usuario
POSTGRES_USUARIO_PASSWORD=usuario_dev_pass

POSTGRES_AUTH_DB=auth
POSTGRES_AUTH_USER=auth
POSTGRES_AUTH_PASSWORD=auth_dev_pass

# === JWT ===
JWT_SECRET=change-me-in-production-min-32-chars-long-secret

# === RabbitMQ (mensajeria asincrona EP2/EP3) ===
RABBITMQ_USER=smartlogix
RABBITMQ_PASSWORD=smartlogix_dev_pass
# Cookie Erlang compartida por rabbit1 y rabbit2 para formar el cluster de 2 nodos.
# Debe ser el MISMO valor en ambos nodos. Cambiar en produccion.
RABBITMQ_ERLANG_COOKIE=smartlogix_cluster_cookie_2026

# === Frontend (Vite) ===
# Base del API que consume el frontend (gateway/BFF). Por defecto el build usa http://localhost:8090/api
FRONTEND_API_BASE=http://localhost:8090/api
# API key de Google Gemini para el AI Hub. Si se deja vacía, el AI Hub funciona en modo simulado.
VITE_GEMINI_API_KEY=

# === GlitchTip (error tracking, compatible con SDK de Sentry) ===
# Stack self-hosted en infra/glitchtip/. Clave secreta de la instancia de GlitchTip
# (usar una cadena larga aleatoria; el default del compose solo sirve para dev).
GLITCHTIP_SECRET_KEY=change-me-long-random-secret
GLITCHTIP_DOMAIN=http://localhost:8000
# DSN por componente. Se obtienen tras crear cada proyecto en el dashboard de GlitchTip
# (http://localhost:8000). Si se dejan vacios, el SDK queda en no-op (la app funciona igual).
VITE_GLITCHTIP_DSN=
BFF_GLITCHTIP_DSN=
MS_AUTH_DSN=
MS_USER_DSN=
MS_ORDER_DSN=
MS_INVENTORY_DSN=
MS_SHIPPING_DSN=
MS_BROKER_ADMIN_DSN=

# === Hosts ===
# Modificar /etc/hosts (linux/mac) o C:\Windows\System32\drivers\etc\hosts (windows):
#   127.0.0.1 app.smartlogix.localhost
#   127.0.0.1 api.smartlogix.localhost
#   127.0.0.1 bff.smartlogix.localhost
#   127.0.0.1 traefik.smartlogix.localhost
# (en Linux *.localhost suele resolver automaticamente; en Windows hace falta agregarlo)
