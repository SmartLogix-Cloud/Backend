# Kafka - copiar a .env:  cp .env.example .env

# Host/IP que los brokers anuncian a los clientes externos (listener EXTERNAL).
#   - Local (microservicios en Docker Desktop): host.docker.internal
#   - AWS: IP PRIVADA de esta EC2 (la usan los microservicios de la EC2-app)
KAFKA_ADVERTISED_HOST=host.docker.internal

# Kafka UI
KAFKA_UI_PORT=8088
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=change-me
