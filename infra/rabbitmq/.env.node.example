# RabbitMQ - un nodo del cluster. Copiar a .env en CADA EC2 de mensajeria.

# --- EC2-mq1 ---
RABBIT_NODE_HOST=rabbit1
RABBIT_PEER_HOST=rabbit2
RABBIT_PEER_IP=10.0.1.20        # IP privada de EC2-mq2

# --- EC2-mq2 (usar estos valores en la otra instancia) ---
# RABBIT_NODE_HOST=rabbit2
# RABBIT_PEER_HOST=rabbit1
# RABBIT_PEER_IP=10.0.1.10      # IP privada de EC2-mq1

# Iguales en ambos nodos
RABBITMQ_USER=smartlogix
RABBITMQ_PASSWORD=change-me
# Cadena larga aleatoria, IDENTICA en los dos nodos (ej: openssl rand -hex 32)
RABBITMQ_ERLANG_COOKIE=change-me-same-cookie-on-both-nodes
