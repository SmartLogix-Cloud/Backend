# BFF (Node/Express) - variables de entorno
# Copiar a .env:  cp .env.example .env

PORT=3000

# URLs internas de los microservicios
MS_INVENTORY_URL=http://ms-inventory:8080
MS_ORDER_URL=http://ms-order:8080
MS_SHIPPING_URL=http://ms-shipping:8080
MS_USER_URL=http://ms-user:8080

# --- Microsoft Entra ID (validación de JWT) ---
# Ver docs/azure/entra-msal-setup.md
AZURE_TENANT_ID=<tenant-id>
# Audience aceptada = client-id de la API (y/o el App ID URI)
AZURE_API_AUDIENCE=<client-id>
# Si se omiten, se derivan de AZURE_TENANT_ID (endpoint v2.0):
AZURE_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AZURE_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

# Error tracking (opcional)
BFF_GLITCHTIP_DSN=
